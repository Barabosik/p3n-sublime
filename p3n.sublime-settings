// p3n settings. Change them in Preferences > Package Settings > p3n > Settings, in the file on the right.
{
	// An API key from https://p3n.si/dashboard/keys. Without one, p3n gives you 10 calls an hour, up to
	// 5,000 characters each. "p3n: Set API Key" in the command palette checks a key with p3n before saving it.
	// The P3N_API_KEY environment variable works too; this setting wins when both are set.
	// This file is plain text: if you sync or publish your User folder, keep the key out of it.
	"api_key": "",

	// After a check, underline the sentences that read as AI (and the pattern hits, dotted).
	"highlight_sentences": true,

	// Also show why each underlined sentence reads as AI, at the right edge of the view. Off by default: in prose,
	// several sentences share one long line and their reasons crowd it. The card lists every reason anyway.
	"show_reasons": false,
}
